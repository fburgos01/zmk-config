#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <

                &kp ESC    &kp ESC    &kp F1     &kp F2     &kp F3     &kp F4     &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10     &kp F11      &kp F12      &kp DEL       &kp PSCRN

                &kp N0     &kp N1     &kp GRAVE  &kp N1     &kp N2     &kp N3     &kp N4      &kp N5      &kp N7      &kp N8      &kp N9      &kp N0      &kp MINUS    &kp EQUAL     &kp BSPC      &kp HOME

                &kp N2     &kp N3     &kp TAB    &kp Q      &kp W      &kp E      &kp R       &kp N6      &kp U       &kp I       &kp O       &kp P       &kp LBKT     &kp RBKT      &kp BSLH      &kp END

                &kp N4     &kp N5     &kp CLCK   &kp A      &kp S      &kp D      &kp F       &kp T       &kp Y       &kp J       &kp K       &kp L       &kp SEMI     &kp SQT       &kp RET       &kp PG_UP

                &kp N6     &kp N7     &kp LSHFT  &kp Z      &kp X      &kp C      &kp V       &kp G       &kp H       &kp M       &kp COMMA   &kp DOT     &kp FSLH     &kp RSHFT     &kp UP        &kp PG_DN

                &kp N8     &kp N9     &kp LCTRL  &mo 1      &kp LGUI   &kp LALT   &kp SPACE   &kp B       &kp N       &kp SPACE   &kp RALT    &kp Z       &kp RCTRL    &kp LEFT      &kp DOWN      &kp RIGHT
            >;
        };

        fn_layer {
            bindings = <

                /* M1      M2      F1             F2             F3          F4            F5            F6            F7           F8           F9           F10          F11         F12          Del      PrtSc */
                &trans   &trans   &kp C_BRI_DN  &kp C_BRI_UP   &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP      &kp C_PREV   &kp C_NEXT   &kp C_STOP   &kp HOME     &kp END     &bootloader  &trans   &trans
                /* 0        1          `            1            2            3            4            5            7        8        9        0        -        +        Bspc     Home */
                &trans   &trans     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR   &trans   &trans   &trans   &trans   &trans   &trans   &trans   &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans

            >;
        };
    };
};
